# Solana RPC Configuration
HELIUS_API_KEY=your_helius_api_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Strict Smart Volume Detection Thresholds (override defaults if needed)
MIN_BUYS_3MIN=20
MIN_UNIQUE_WALLETS=10
MIN_SOL_VOLUME=15.0
MIN_MARKET_CAP_USD=50000

# Alert Suppression Flags (default: spam off)
DISABLE_BASELINE_ALERTS=1
DISABLE_RPC_BASIC_ALERTS=1
SKIP_STARTUP_MESSAGE=1
TELEGRAM_QUEUE_MAX_SIZE=500

# Optional: Adjust Telegram send pacing (seconds between messages)
TELEGRAM_MIN_INTERVAL=1.5

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values with your actual credentials
# 3. Get Helius API key from: https://dashboard.helius.xyz/
# 4. Get Telegram bot token from: @BotFather on Telegram
# 5. Get your chat ID by messaging your bot and visiting:
#    https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates

# Smart Detection v4 (optional tuning)
# Composite score threshold to trigger alert (default 35)
SMART_SCORE_THRESHOLD=35
# Per-token cooldown between smart alerts in seconds (default 1800 = 30m)
SMART_ALERT_COOLDOWN_SECONDS=1800
# Global cap on smart alerts per minute (default 10)
SMART_GLOBAL_CAP_PER_MIN=10
# Evaluation window in seconds (default 180 = 3m)
SMART_WINDOW_SECONDS=180
# Time window for clustering adjacent buys, in seconds (default 10)
SMART_CLUSTER_WINDOW_SECONDS=10
# Score down-weight factor when MC < MIN_MARKET_CAP_USD (default 0.6)
SMART_MC_DOWNWEIGHT_FACTOR=0.6

# ============================================================================
# RESURGENCE MODE - Detect established tokens regaining volume (not new launches)
# ============================================================================
# Enable resurgence mode (default: true)
RESURGENCE_MODE=true
# Minimum token age in seconds before considering (default 3600 = 1 hour)
MIN_TOKEN_AGE_SECONDS=3600
# Require token to have existing market cap on DexScreener (default: true)
REQUIRE_EXISTING_MC=true
# Minimum existing market cap to be considered "established" (default $5000)
MIN_EXISTING_MC_USD=5000

# ============================================================================
# [v4.25] ALCHEMY WS — push-based new-pair detection for BSC / Base / Ethereum
# ============================================================================
# One free Alchemy account + API key covers all three chains.
# Sign up at https://www.alchemy.com/ -> create an app -> copy the API key
# (not the full URL, just the key at the end).
# Leave this unset/blank to keep BSC/Base/ETH on DexScreener polling only —
# nothing breaks, you just lose the instant push-based detection.
ALCHEMY_API_KEY=your_alchemy_api_key_here
