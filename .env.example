# Solana RPC Configuration
HELIUS_API_KEY=your_helius_api_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================================
# KOL / TWEET TRACKING (optional — /addkol lets you watch accounts for ticker
# mentions)
# ============================================================================
# Primary path is free: scraping KOL tweets via public Nitter RSS mirrors
# (NITTER_INSTANCES, in code). [v4.32] Nitter as a whole is under sustained
# pressure from X and instance uptime/RSS availability fluctuates — if KOL
# alerts aren't firing even though you've added accounts with /addkol, this
# is the most likely reason, and it fails completely silently (no error
# logged) so check /status or just test with a known-active account.
#
# RAPIDAPI_KEY is the fallback path (and the more durable one) — sign up at
# rapidapi.com, subscribe to the "twitter241" API, and put your key here.
# Without it, the fallback silently does nothing when Nitter is down, same
# as Nitter being down does nothing on its own.
# RAPIDAPI_KEY=your_rapidapi_key_here
#
# [v4.33] KOL matching now goes beyond exact $CASHTAG mentions. Every post is
# also scanned for word/phrase overlap against token names/symbols — catches
# the common pattern where a viral word/phrase gets "tokenized" with no $ in
# front of it at all (e.g. "based frog" trending -> a token later launches
# named/symboled BASEDFROG). No new config needed — this runs automatically
# alongside the existing cashtag path, checks both already-tracked tokens AND
# fires a live, rate-limited DexScreener search for untracked matches. See
# kol_stats (keyword_matches_tracked / keyword_live_searches /
# keyword_live_hits) via /status for how often it's firing.
#
# Also fixed this pass: TICKER_RE (the $CASHTAG regex) had a stray invisible
# byte in it that made it never match anything — the exact-cashtag KOL path
# had been silently dead the whole time regardless of Nitter/RapidAPI health.

# Strict Smart Volume Detection Thresholds (override defaults if needed)
MIN_BUYS_3MIN=20
MIN_UNIQUE_WALLETS=10
MIN_SOL_VOLUME=15.0
MIN_MARKET_CAP_USD=50000

# Alert Suppression Flags (default: spam off)
DISABLE_BASELINE_ALERTS=1
DISABLE_RPC_BASIC_ALERTS=1
SKIP_STARTUP_MESSAGE=1
TELEGRAM_QUEUE_MAX_SIZE=500

# Optional: Adjust Telegram send pacing (seconds between messages)
TELEGRAM_MIN_INTERVAL=1.5

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values with your actual credentials
# 3. Get Helius API key from: https://dashboard.helius.xyz/
# 4. Get Telegram bot token from: @BotFather on Telegram
# 5. Get your chat ID by messaging your bot and visiting:
#    https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates

# Smart Detection v4 (optional tuning)
# Composite score threshold to trigger alert (default 35)
SMART_SCORE_THRESHOLD=35
# Per-token cooldown between smart alerts in seconds (default 1800 = 30m)
SMART_ALERT_COOLDOWN_SECONDS=1800
# Global cap on smart alerts per minute (default 10)
SMART_GLOBAL_CAP_PER_MIN=10
# Evaluation window in seconds (default 180 = 3m)
SMART_WINDOW_SECONDS=180
# Time window for clustering adjacent buys, in seconds (default 10)
SMART_CLUSTER_WINDOW_SECONDS=10
# Score down-weight factor when MC < MIN_MARKET_CAP_USD (default 0.6)
SMART_MC_DOWNWEIGHT_FACTOR=0.6

# ============================================================================
# RESURGENCE MODE - Detect established tokens regaining volume (not new launches)
# ============================================================================
# Enable resurgence mode (default: true)
RESURGENCE_MODE=true
# Minimum token age in seconds before considering (default 3600 = 1 hour)
MIN_TOKEN_AGE_SECONDS=3600
# Require token to have existing market cap on DexScreener (default: true)
REQUIRE_EXISTING_MC=true
# Minimum existing market cap to be considered "established" (default $5000)
MIN_EXISTING_MC_USD=5000

# ============================================================================
# [v4.25] ALCHEMY WS — push-based new-pair detection for BSC / Base / Ethereum
# ============================================================================
# One free Alchemy account + API key covers all three chains.
# Sign up at https://www.alchemy.com/ -> create an app -> copy the API key
# (not the full URL, just the key at the end).
# Leave this unset/blank to keep BSC/Base/ETH on DexScreener polling only —
# nothing breaks, you just lose the instant push-based detection.
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ============================================================================
# [v4.26] PERSISTENT STORAGE — survive Railway redeploys
# ============================================================================
# Railway's container filesystem is ephemeral: anything written outside a
# mounted Volume is wiped every time you redeploy or restart. Without this,
# astaroth_state.json and kol_list.json reset to empty on every deploy — you
# lose alert history, tracked tokens, and your KOL list.
#
# To fix: in the Railway dashboard, add a Volume to this service and mount it
# (e.g. at /data). Railway then auto-injects RAILWAY_VOLUME_MOUNT_PATH — no
# extra env var needed here, the app detects it automatically.
#
# DATA_DIR is only a manual override/fallback for non-Railway hosts that don't
# set RAILWAY_VOLUME_MOUNT_PATH themselves. Leave both unset on Railway once a
# Volume is attached.
#
# [v4.31] astaroth.db (a SQLite alert-history log) lives in this same
# directory and follows the exact same survive/reset behavior — no separate
# config needed. It's additive: astaroth_state.json/kol_list.json are still
# the source of truth for live tracking state, this just gives you queryable
# alert history that isn't capped or wiped from an in-memory ring buffer.
# Query it via GET /db/alerts (?limit=&chain=&symbol=) and GET /db/stats.
# No new dependency either — plain stdlib sqlite3, nothing to add to
# requirements.txt. If the DB file can't be created/opened for any reason,
# the bot logs a warning and runs exactly as it did before this existed.
# DATA_DIR=/data

# ============================================================================
# [v4.28] MARKET-CAP CATCH WINDOW — per chain, all env-overridable
# ============================================================================
# Default alert window on every chain is now $10,000-$50,000 market cap —
# tuned to catch tokens early rather than after they've already run (started
# at a $30k ceiling, raised to $50k after live data showed too few tokens
# had time to clear the volume/buy-ratio/min-buys gates before aging out of
# a tighter window). Override per chain with {PREFIX}_MC_MIN / {PREFIX}_MC_MAX,
# prefix is SOL / BSC / BASE / ETH. Example: widen Solana back out further:
# SOL_MC_MAX=100000
#
# Note: GEM_FAST_MC_MIN / GEM_VOL_ACCEL_MC_MAX (in code, not env vars) bound
# the fast-velocity and vol-acceleration alert paths, which bypass the normal
# per-chain mc_min/mc_max — both are set to 10000/30000 to match this window.

# ============================================================================
# [v4.34] RUNNER MOMENTUM PATH + balanced threshold loosening
# ============================================================================
# Every alert path used to require mc <= mc_max (~$50k) -- meaning a token
# that already broke past that ceiling on real, current buy pressure was
# invisible to every path, no matter how strong the signal. There's now a
# separate RUNNER🚀 path for exactly that case: mc > mc_max, mc <= this
# ceiling, plus real evidence of CURRENT acceleration (velocity, vol-accel,
# or buy-vol-accel), not just a healthy ratio. It's additive -- doesn't
# loosen or replace any existing path, it only catches what they structurally
# couldn't. GEM_MOMENTUM_MC_MAX is a sanity ceiling (default $2M), not a
# "still cheap" window -- RESURGENCE_MODE already covers the separate
# "established token regaining volume" case.
# GEM_MOMENTUM_MC_MAX=2000000
#
# Also this pass: buy_ratio_min, min_buys_h1, and vol_mc_ratio were loosened
# a further notch per chain in CHAIN_THRESHOLDS (in code) -- e.g. bsc/base
# buy_ratio_min 0.48->0.45, min_buys_h1 6->5; ethereum min_buys_h1 3->2;
# vol_mc_ratio down ~20-25% relative per chain. All still per-chain
# env-overridable ({PREFIX}_BUY_RATIO_MIN, {PREFIX}_MIN_BUYS_H1,
# {PREFIX}_VOL_MC_RATIO) if any chain needs dialing back toward the old
# values. See the CHAIN_THRESHOLDS comment in code for the full reasoning.

# ============================================================================
# [v4.29] DIRECT PUMP.FUN INDEXING — bypass the PumpPortal relay via Helius
# ============================================================================
# PumpPortal (wss://pumpportal.fun/api/data) is itself a third party reading
# pump.fun's on-chain Solana program and republishing it as JSON. This lets
# the bot read that same program directly instead, using the Helius API key
# already configured above (HELIUS_API_KEY) — no extra credentials needed.
#
# PUMPFUN_DIRECT_MODE=off     (default) PumpPortal WS only. No change.
# PUMPFUN_DIRECT_MODE=shadow  Direct listener runs alongside PumpPortal,
#                              decodes events and logs stats (see /status ->
#                              pumpfun_direct) but does NOT feed alerts —
#                              safe way to sanity-check the decoder against
#                              PumpPortal's parallel feed before cutting over.
# PUMPFUN_DIRECT_MODE=live    Direct listener replaces PumpPortal entirely.
#                              Also removes PumpPortal's 50-token trade-feed
#                              subscription cap — every pump.fun trade is seen.
#
# Recommended rollout: run "shadow" for a while, compare pumpfun_direct stats
# and shadow-mode log lines against the normal WS NEW/alert lines, then
# switch to "live" once you're confident the decoded data matches.
PUMPFUN_DIRECT_MODE=off

# ============================================================================
# [v4.30] SOLANA DISABLED — all capacity/tuning effort now goes to BSC/Base/ETH
# ============================================================================
# ENABLE_SOLANA now defaults to false in code. This is a config flip, not a
# code removal — PumpPortal, the direct pump.fun indexer above, and squat-
# guard dedup all still work, they just don't start. Set ENABLE_SOLANA=true
# to bring Solana back with no code changes.
# ENABLE_SOLANA=true
#
# What changed for BSC/Base/Ethereum as a result of this pass:
#  - CRITICAL FIX: _PAIR_CREATED_TOPIC and _POOL_CREATED_TOPIC (in code) were
#    each truncated by one trailing hex character, so PancakeV2/V3 (BSC) and
#    UniswapV2/V3 (Ethereum + Base) WS discovery has been silently dead this
#    whole time — only Aerodrome on Base ever actually reached WS discovery.
#    Fixed; these three chains should see meaningfully more WS-discovered
#    pairs going forward, on top of anything below.
#  - Added SushiSwap V2 (Ethereum) and SushiSwap V3 (Ethereum + Base) to
#    EVM_FACTORIES — same Uniswap-fork event shapes, just more factories
#    watched per chain.
#  - NEW_PAIRS_SCAN_DEPTH (below) scans deeper into DexScreener's combined
#    new-pairs feed now that Solana's share of it is always discarded.
#  - buy_ratio_min loosened 0.52 -> 0.48 and min_buys_h1 lowered 8 -> 6 for
#    bsc/base (see CHAIN_THRESHOLDS in code) — these two chains no longer
#    share the global alert-rate budget with Solana's much higher alert
#    frequency, so there's room to act on slightly less-proven signals.
#    Still per-chain env-overridable (BSC_BUY_RATIO_MIN, BASE_MIN_BUYS_H1, etc).
#
# How deep into DexScreener's ALL-CHAINS combined new-pairs feed to scan
# before filtering to enabled chains (default 400). Needs to scan deeper as
# fewer chains are enabled, not shallower — Solana's real-world share of that
# feed doesn't shrink just because this bot stopped tracking it.
NEW_PAIRS_SCAN_DEPTH=400
