# Solana RPC Configuration
HELIUS_API_KEY=your_helius_api_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================================
# KOL / TWEET TRACKING (optional — /addkol lets you watch accounts for ticker
# mentions)
# ============================================================================
# Primary path is free: scraping KOL tweets via public Nitter RSS mirrors
# (NITTER_INSTANCES, in code). [v4.32] Nitter as a whole is under sustained
# pressure from X and instance uptime/RSS availability fluctuates — if KOL
# alerts aren't firing even though you've added accounts with /addkol, this
# is the most likely reason, and it fails completely silently (no error
# logged) so check /status or just test with a known-active account.
#
# RAPIDAPI_KEY is the fallback path (and the more durable one) — sign up at
# rapidapi.com, subscribe to the "twitter241" API, and put your key here.
# Without it, the fallback silently does nothing when Nitter is down, same
# as Nitter being down does nothing on its own.
# RAPIDAPI_KEY=your_rapidapi_key_here
#
# [v4.33] KOL matching now goes beyond exact $CASHTAG mentions. Every post is
# also scanned for word/phrase overlap against token names/symbols — catches
# the common pattern where a viral word/phrase gets "tokenized" with no $ in
# front of it at all (e.g. "based frog" trending -> a token later launches
# named/symboled BASEDFROG). No new config needed — this runs automatically
# alongside the existing cashtag path, checks both already-tracked tokens AND
# fires a live, rate-limited DexScreener search for untracked matches. See
# kol_stats (keyword_matches_tracked / keyword_live_searches /
# keyword_live_hits) via /status for how often it's firing.
#
# Also fixed this pass: TICKER_RE (the $CASHTAG regex) had a stray invisible
# byte in it that made it never match anything — the exact-cashtag KOL path
# had been silently dead the whole time regardless of Nitter/RapidAPI health.

# Strict Smart Volume Detection Thresholds (override defaults if needed)
MIN_BUYS_3MIN=20
MIN_UNIQUE_WALLETS=10
MIN_SOL_VOLUME=15.0
MIN_MARKET_CAP_USD=50000

# Alert Suppression Flags (default: spam off)
DISABLE_BASELINE_ALERTS=1
DISABLE_RPC_BASIC_ALERTS=1
SKIP_STARTUP_MESSAGE=1
TELEGRAM_QUEUE_MAX_SIZE=500

# Optional: Adjust Telegram send pacing (seconds between messages)
TELEGRAM_MIN_INTERVAL=1.5

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values with your actual credentials
# 3. Get Helius API key from: https://dashboard.helius.xyz/
# 4. Get Telegram bot token from: @BotFather on Telegram
# 5. Get your chat ID by messaging your bot and visiting:
#    https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates

# Smart Detection v4 (optional tuning)
# Composite score threshold to trigger alert (default 35)
SMART_SCORE_THRESHOLD=35
# Per-token cooldown between smart alerts in seconds (default 1800 = 30m)
SMART_ALERT_COOLDOWN_SECONDS=1800
# Global cap on smart alerts per minute (default 10)
SMART_GLOBAL_CAP_PER_MIN=10
# Evaluation window in seconds (default 180 = 3m)
SMART_WINDOW_SECONDS=180
# Time window for clustering adjacent buys, in seconds (default 10)
SMART_CLUSTER_WINDOW_SECONDS=10
# Score down-weight factor when MC < MIN_MARKET_CAP_USD (default 0.6)
SMART_MC_DOWNWEIGHT_FACTOR=0.6

# ============================================================================
# RESURGENCE MODE - Detect established tokens regaining volume (not new launches)
# ============================================================================
# Enable resurgence mode (default: true)
RESURGENCE_MODE=true
# Minimum token age in seconds before considering (default 3600 = 1 hour)
MIN_TOKEN_AGE_SECONDS=3600
# Require token to have existing market cap on DexScreener (default: true)
REQUIRE_EXISTING_MC=true
# Minimum existing market cap to be considered "established" (default $5000)
MIN_EXISTING_MC_USD=5000

# ============================================================================
# [v4.25] ALCHEMY WS — push-based new-pair detection for BSC / Base / Ethereum
# ============================================================================
# One free Alchemy account + API key covers all three chains.
# Sign up at https://www.alchemy.com/ -> create an app -> copy the API key
# (not the full URL, just the key at the end).
# Leave this unset/blank to keep BSC/Base/ETH on DexScreener polling only —
# nothing breaks, you just lose the instant push-based detection.
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ============================================================================
# [v4.26] PERSISTENT STORAGE — survive Railway redeploys
# ============================================================================
# Railway's container filesystem is ephemeral: anything written outside a
# mounted Volume is wiped every time you redeploy or restart. Without this,
# astaroth_state.json and kol_list.json reset to empty on every deploy — you
# lose alert history, tracked tokens, and your KOL list.
#
# To fix: in the Railway dashboard, add a Volume to this service and mount it
# (e.g. at /data). Railway then auto-injects RAILWAY_VOLUME_MOUNT_PATH — no
# extra env var needed here, the app detects it automatically.
#
# DATA_DIR is only a manual override/fallback for non-Railway hosts that don't
# set RAILWAY_VOLUME_MOUNT_PATH themselves. Leave both unset on Railway once a
# Volume is attached.
#
# [v4.31] astaroth.db (a SQLite alert-history log) lives in this same
# directory and follows the exact same survive/reset behavior — no separate
# config needed. It's additive: astaroth_state.json/kol_list.json are still
# the source of truth for live tracking state, this just gives you queryable
# alert history that isn't capped or wiped from an in-memory ring buffer.
# Query it via GET /db/alerts (?limit=&chain=&symbol=) and GET /db/stats.
# No new dependency either — plain stdlib sqlite3, nothing to add to
# requirements.txt. If the DB file can't be created/opened for any reason,
# the bot logs a warning and runs exactly as it did before this existed.
# DATA_DIR=/data

# ============================================================================
# [v4.28] MARKET-CAP CATCH WINDOW — per chain, all env-overridable
# ============================================================================
# Default alert window on every chain is now $10,000-$50,000 market cap —
# tuned to catch tokens early rather than after they've already run (started
# at a $30k ceiling, raised to $50k after live data showed too few tokens
# had time to clear the volume/buy-ratio/min-buys gates before aging out of
# a tighter window). Override per chain with {PREFIX}_MC_MIN / {PREFIX}_MC_MAX,
# prefix is SOL / BSC / BASE / ETH. Example: widen Solana back out further:
# SOL_MC_MAX=100000
#
# Note: GEM_FAST_MC_MIN / GEM_VOL_ACCEL_MC_MAX (in code, not env vars) bound
# the fast-velocity and vol-acceleration alert paths, which bypass the normal
# per-chain mc_min/mc_max — both are set to 10000/30000 to match this window.

# ============================================================================
# [v4.34] RUNNER MOMENTUM PATH + balanced threshold loosening
# ============================================================================
# Every alert path used to require mc <= mc_max (~$50k) -- meaning a token
# that already broke past that ceiling on real, current buy pressure was
# invisible to every path, no matter how strong the signal. There's now a
# separate RUNNER🚀 path for exactly that case: mc > mc_max, mc <= this
# ceiling, plus real evidence of CURRENT acceleration (velocity, vol-accel,
# or buy-vol-accel), not just a healthy ratio. It's additive -- doesn't
# loosen or replace any existing path, it only catches what they structurally
# couldn't. GEM_MOMENTUM_MC_MAX is a sanity ceiling (default $2M), not a
# "still cheap" window -- RESURGENCE_MODE already covers the separate
# "established token regaining volume" case.
# GEM_MOMENTUM_MC_MAX=2000000
#
# Also this pass: buy_ratio_min, min_buys_h1, and vol_mc_ratio were loosened
# a further notch per chain in CHAIN_THRESHOLDS (in code) -- e.g. bsc/base
# buy_ratio_min 0.48->0.45, min_buys_h1 6->5; ethereum min_buys_h1 3->2;
# vol_mc_ratio down ~20-25% relative per chain. All still per-chain
# env-overridable ({PREFIX}_BUY_RATIO_MIN, {PREFIX}_MIN_BUYS_H1,
# {PREFIX}_VOL_MC_RATIO) if any chain needs dialing back toward the old
# values. See the CHAIN_THRESHOLDS comment in code for the full reasoning.

# ============================================================================
# [v4.29] DIRECT PUMP.FUN INDEXING — bypass the PumpPortal relay via Helius
# ============================================================================
# PumpPortal (wss://pumpportal.fun/api/data) is itself a third party reading
# pump.fun's on-chain Solana program and republishing it as JSON. This lets
# the bot read that same program directly instead, using the Helius API key
# already configured above (HELIUS_API_KEY) — no extra credentials needed.
#
# PUMPFUN_DIRECT_MODE=off     (default) PumpPortal WS only. No change.
# PUMPFUN_DIRECT_MODE=shadow  Direct listener runs alongside PumpPortal,
#                              decodes events and logs stats (see /status ->
#                              pumpfun_direct) but does NOT feed alerts —
#                              safe way to sanity-check the decoder against
#                              PumpPortal's parallel feed before cutting over.
# PUMPFUN_DIRECT_MODE=live    Direct listener replaces PumpPortal entirely.
#                              Also removes PumpPortal's 50-token trade-feed
#                              subscription cap — every pump.fun trade is seen.
#
# Recommended rollout: run "shadow" for a while, compare pumpfun_direct stats
# and shadow-mode log lines against the normal WS NEW/alert lines, then
# switch to "live" once you're confident the decoded data matches.
PUMPFUN_DIRECT_MODE=off

# ============================================================================
# [v4.30] SOLANA DISABLED — all capacity/tuning effort now goes to BSC/Base/ETH
# ============================================================================
# ENABLE_SOLANA now defaults to false in code. This is a config flip, not a
# code removal — PumpPortal, the direct pump.fun indexer above, and squat-
# guard dedup all still work, they just don't start. Set ENABLE_SOLANA=true
# to bring Solana back with no code changes.
# ENABLE_SOLANA=true
#
# What changed for BSC/Base/Ethereum as a result of this pass:
#  - CRITICAL FIX: _PAIR_CREATED_TOPIC and _POOL_CREATED_TOPIC (in code) were
#    each truncated by one trailing hex character, so PancakeV2/V3 (BSC) and
#    UniswapV2/V3 (Ethereum + Base) WS discovery has been silently dead this
#    whole time — only Aerodrome on Base ever actually reached WS discovery.
#    Fixed; these three chains should see meaningfully more WS-discovered
#    pairs going forward, on top of anything below.
#  - Added SushiSwap V2 (Ethereum) and SushiSwap V3 (Ethereum + Base) to
#    EVM_FACTORIES — same Uniswap-fork event shapes, just more factories
#    watched per chain.
#  - NEW_PAIRS_SCAN_DEPTH (below) scans deeper into DexScreener's combined
#    new-pairs feed now that Solana's share of it is always discarded.
#  - buy_ratio_min loosened 0.52 -> 0.48 and min_buys_h1 lowered 8 -> 6 for
#    bsc/base (see CHAIN_THRESHOLDS in code) — these two chains no longer
#    share the global alert-rate budget with Solana's much higher alert
#    frequency, so there's room to act on slightly less-proven signals.
#    Still per-chain env-overridable (BSC_BUY_RATIO_MIN, BASE_MIN_BUYS_H1, etc).
#
# How deep into DexScreener's ALL-CHAINS combined new-pairs feed to scan
# before filtering to enabled chains (default 400). Needs to scan deeper as
# fewer chains are enabled, not shallower — Solana's real-world share of that
# feed doesn't shrink just because this bot stopped tracking it.
NEW_PAIRS_SCAN_DEPTH=400

# ============================================================================
# [v4.35] FOUR.MEME COVERAGE — BSC's dominant pump.fun-equivalent launchpad
# ============================================================================
# Everything on four.meme launches and trades on a bonding curve BEFORE it
# ever reaches a real DEX pair (PancakeSwap), which means the existing
# PancakeV2/V3 factory watcher structurally can't see it until/unless a token
# graduates and migrates liquidity — by which point most of the early move is
# already over. This listens directly to four.meme's TokenManager2 contract
# (0x5c95...0762b) over the same Alchemy WS connection already used for
# BSC/Base/ETH, decoding TokenCreate/TokenPurchase/TokenSale events with a
# small dependency-free ABI decoder (no web3.py/eth_abi added — same
# philosophy as the existing pump.fun Anchor-event borsh decoder).
#
# Important honesty note: the contract address and event signatures were
# cross-verified across three independent sources (the platform's own
# machine-generated ABI, a public Solidity interface mirror, and an
# independently-recomputed keccak256 of each event signature) but this
# sandbox has no outbound RPC/BscScan access, so the decoder could NOT be
# checked against a real, live on-chain transaction the way the earlier
# pump.fun topic0 fix was. Treat "shadow" mode below as required, not
# optional, before trusting this for real alerts.
#
# Also deliberate: four.meme's bonding-curve pricing formula isn't published,
# so this does NOT attempt to estimate a real USD market cap. It tracks
# fourmeme_raised_usd (BNB raised so far on the curve, converted to USD) as
# its own separate field — never written into token.market_cap — and alerts
# through its own CURVE🌊 path, gated by FOURMEME_MIN_RAISED_USD /
# FOURMEME_MAX_RAISED_USD below, so an unverified number can never leak into
# the real-dollar-MC-gated GEM/RUNNER/etc. paths.
#
# FOURMEME_MODE=off     (default) No four.meme subscription at all. No change.
# FOURMEME_MODE=shadow  Subscribes and decodes events, logs them and updates
#                        /status -> fourmeme stats, but raises no alerts —
#                        use this to sanity-check decoded names/symbols/raised
#                        amounts against the real four.meme.com site or
#                        BscScan before trusting it.
# FOURMEME_MODE=live    Decoded tokens are tracked and can fire the CURVE🌊
#                        alert path once raised-USD is within the window below.
FOURMEME_MODE=off
#
# CURVE🌊 alert window — BNB-raised-on-curve converted to USD (curve
# graduates around 24 BNB raised). Defaults tuned to the "balanced" fine-
# tuning pass: catch a token with real, provable buy pressure on the curve
# without alerting on the very first few buys or waiting until it's about to
# graduate anyway.
FOURMEME_MIN_RAISED_USD=2000
FOURMEME_MAX_RAISED_USD=12000

# ============================================================================
# [v4.36] EVM PAIRS NOW PRE-TRACKED IMMEDIATELY — no config needed
# ============================================================================
# Diagnosed after noticing BSC/Base/ETH were barely producing any alerts even
# after the four.meme + RUNNER work above: a plain PancakeV2/V3, Uniswap,
# Sushi, or Aerodrome pair only became trackable once DexScreener returned
# real data for it — up to ~55 seconds of retries, and if DexScreener never
# indexed it at all (common; its EVM coverage lags pump.fun's a lot), the
# token was silently dropped forever, taking its entire early trading history
# with it. Real production logs showed roughly 8 of 25 BSC pair-creations,
# 1 of 6 on Ethereum, and 0 of 2 on Base actually reaching "tracked" status
# in a 30-minute window, and none of the ones that did clear any alert gate.
#
# Fixed the same way pump.fun and four.meme already work: every EVM pair is
# now tracked from the instant it's created, with swap events counted from
# second one instead of waiting on DexScreener. There's no liquidity/MC
# estimate possible at that point (a PairCreated event carries no reserves,
# unlike a bonding curve's raised amount), so a new FRESH🌱 alert path fires
# off real WS-derived dollar volume + trade count + buy dominance instead —
# deliberately kept off every mc_min/mc_max-gated path, same reasoning as
# CURVE🌊 above. It stops firing the moment DexScreener actually enriches the
# token (liquidity becomes real) and the normal GEM/RUNNER/VOL paths take
# over from there with real numbers.
#
# No mode flag here — unlike PUMPFUN_DIRECT_MODE/FOURMEME_MODE this isn't a
# new decoder needing a shadow-test period, just fixing when an already-
# working pipeline starts counting. Two knobs to tune false-positive risk if
# FRESH🌱 fires too often or not enough:
EVM_FRESH_MIN_TRADES=8
EVM_FRESH_MIN_USD_VOL=1000
# See evm_ws stats via /status (pre_tracked / fresh_alerts per chain) to see
# how many pairs are being caught this way and how many of those alert.

# ============================================================================
# [v4.37] ROBINHOOD CHAIN — new EVM chain, Uniswap V3 pairs only
# ============================================================================
# Robinhood Chain (chain id 4663) is a real, live Arbitrum Orbit L2 —
# EVM-compatible, ETH gas token, live on Alchemy since ~2026-07 and indexed
# by DexScreener at dexscreener.com/robinhood. Wired up the same way as
# ethereum/bsc/base: DexScreener polling + Alchemy WS discovery
# (PairCreated/PoolCreated), feeding into the same generic EVM pipeline.
# [v4.39 note] The "instant pre-track stub" this section originally described
# no longer exists on ANY chain — see the v4.39 section below. A Robinhood
# Chain pair, like every other chain now, only starts being tracked once its
# real MC (from DexScreener) already falls inside the entry window.
#
# Scope of this pass, by explicit choice (not yet done): only the vanilla
# Uniswap V3 factory is watched (address verified against Uniswap's own
# deployments doc, 2026-08-29). NOT covered:
#   - This chain's meme launchpads (robinhood.fun, NOXA Fun, Uniswap's own
#     Pools.trade) — each is its own bonding-curve contract needing the same
#     kind of dedicated ABI/event research four.meme got. Real activity
#     happens there before tokens ever hit a Uniswap pair, same gap four.meme
#     closed for BSC — worth doing as a follow-up.
#   - Pairs quoted against tokenized stock tokens (NVDA, COIN, SPY, PLTR,
#     HIMS, ...) instead of WETH — common on this chain, but pricing them
#     needs a live stock price feed, not a crypto price, so they're left
#     unrecognized (still get pair-discovered/pre-tracked, just no USD
#     volume estimate).
#   - USDG (Global Dollar), this chain's other real WETH-adjacent base asset
#     — its decimals() couldn't be verified from this environment (public
#     RPC isn't on the sandbox's egress allowlist) so it was deliberately
#     left out rather than guessed. Confirm on-chain or via Paxos's docs,
#     then add it next to WETH in EVM_BASE_TOKENS/EVM_BASE_TOKEN_DECIMALS.
#
# No new env vars required to turn this on (mirrors ENABLE_BSC/ENABLE_BASE/
# ENABLE_ETH's already-on-by-default pattern) — set ENABLE_ROBINHOOD=false to
# disable, or leave ALCHEMY_API_KEY_ROBINHOOD / ALCHEMY_API_KEY unset to keep
# it on DexScreener-polling-only (no WS pre-track) like the others.
# ENABLE_ROBINHOOD=true
# ALCHEMY_API_KEY_ROBINHOOD=
# RH_MC_MIN / RH_MC_MAX / RH_AGE_MIN / RH_AGE_MAX / RH_VOL_MIN / RH_VOL_MAX /
# RH_LIQ_MIN / RH_BUY_RATIO_MIN / RH_MIN_BUYS_H1 — per-chain threshold
# overrides, same pattern as SOL_*/BSC_*/BASE_*/ETH_*. Starts as a copy of
# BSC's thresholds (no live tuning history yet for this brand-new chain).

# ============================================================================
# [v4.39] NO MORE INSTANT TRACKING — entry gated on MC + volume windows
# ============================================================================
# Explicit request: stop tracking a token the instant it's created. Every
# "pre-track a stub before real data exists" mechanism added this session
# (Solana's WS-estimated stub, the EVM PairCreated stub, i.e. FRESH🌱) is now
# gated or removed:
#   - Solana: the WS creation event DOES carry a real, on-chain-derived MC
#     estimate (mc_sol * SOL price), so a stub is still created immediately
#     — but ONLY if that first-observed estimate already lands inside
#     SOL_MC_MIN..SOL_MC_MAX. If not, the mint is skipped for good; nothing
#     re-checks it later as trades come in. Consequence worth knowing: most
#     pump.fun tokens launch well under $10k (commonly ~$5-8k at the typical
#     ~28-40 SOL starting range seen in production logs) — this floor alone
#     will skip the large majority of Solana launches at creation. That's the
#     direct tradeoff of "first observation only, no background watching."
#   - Vanilla EVM pairs (bsc/base/ethereum/robinhood): PairCreated/PoolCreated
#     carries no reserves, so there was never a real MC estimate possible at
#     that instant anyway. The FRESH🌱 stub is removed outright — these pairs
#     now only start being tracked once DexScreener returns real MC data (the
#     same behavior this bot had before this session's EVM pre-track fix).
#     Pair metadata is still recorded at discovery time either way, so swap
#     attribution still works correctly IF/once a pair does get tracked.
#   - four.meme (FOURMEME_MODE=live, BSC bonding-curve) is UNCHANGED — it has
#     no real dollar MC signal at all pre-migration (see the FOURMEME_MODE
#     comment block above), so there's no MC value to gate this rule on. It
#     wasn't part of this request and stays off by default either way.
#
# Once a token DOES start being tracked, the core alert gate (the GEM/
# FAST🔥/EARLY📈/RUNNER🚀 paths) now checks an absolute-dollar MC window AND
# an absolute-dollar volume window — replacing the old vol/mc PERCENTAGE
# ratio entirely:
#   - solana: MC $10,000-$30,000, volume $10,000-$30,000
#   - bsc / base / ethereum / robinhood: MC $5,000-$50,000, volume $10,000-$50,000
# Both windows are per-chain env-overridable, same *_MC_MIN/*_MC_MAX pattern
# as always, plus the new *_VOL_MIN/*_VOL_MAX (replaces *_VOL_MC_RATIO):
SOL_MC_MIN=10000
SOL_MC_MAX=30000
SOL_VOL_MIN=10000
SOL_VOL_MAX=30000
BSC_MC_MIN=5000
BSC_MC_MAX=50000
BSC_VOL_MIN=10000
BSC_VOL_MAX=50000
BASE_MC_MIN=5000
BASE_MC_MAX=50000
BASE_VOL_MIN=10000
BASE_VOL_MAX=50000
ETH_MC_MIN=5000
ETH_MC_MAX=50000
ETH_VOL_MIN=10000
ETH_VOL_MAX=50000
RH_MC_MIN=5000
RH_MC_MAX=50000
RH_VOL_MIN=10000
RH_VOL_MAX=50000
# NOTE: VOL💰/VACCEL📊 (eth_vol_signal/eth_vol_accel) and RUNNER🚀
# (momentum_running) are NOT bounded by *_VOL_MAX — they're separate,
# deliberately-different signals (buy-side accumulation pressure, and
# already-past-mc_max acceleration respectively) that predate this change.
# RUNNER🚀 in particular exists specifically to catch tokens already above
# mc_max, where real volume routinely and correctly exceeds *_VOL_MAX — capping
# it the same way would make that path nearly unreachable, so it only checks
# a volume FLOOR (still respects *_VOL_MIN). mc_ok (the tightened MC window)
# still applies everywhere.

# ============================================================================
# [v4.40] SOLANA ENTRY CHECK — delayed once, instead of judged at t=0
# ============================================================================
# Follow-up to v4.39: SOL_MC_MIN=$10k alone meant almost every pump.fun token
# got judged and dropped before it had traded at all (real launches commonly
# start ~$5-8k). Fix: a new mint no longer gets judged the instant it's
# created. It's parked in a pending state (not yet a tracked token), given a
# live trade-feed subscription for a short bounded window, and checked
# EXACTLY ONCE, SOL_ENTRY_CHECK_DELAY seconds later, against SOL_MC_MIN/
# SOL_MC_MAX. If its MC (now reflecting real trades, not just the creation-
# time snapshot) is in range, it's promoted to a real tracked token --
# carrying over whatever buy/sell activity happened during the wait, so
# that data isn't thrown away. If not, it's dropped for good; nothing
# revisits it afterward. Still "look once" -- just timed to give a real
# launch a fair chance to show what it's doing before being judged.
SOL_ENTRY_CHECK_DELAY=45
# How many pending (not-yet-decided) mints can hold a live trade-feed
# subscription at once, out of the shared 50-subscription PumpPortal cap
# (WS_MAX_TRADE_SUBS) -- the rest of that cap stays available for already-
# alerted tokens' subscriptions, same pool, added via the same queue.
# A mint that doesn't get a subscription slot (cap already full) still gets
# its one-shot check -- just against its frozen creation-time MC, same as
# before this fix, instead of a live-updated one.
SOL_PENDING_SUB_CAP=15
